{
  "name": "latk-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "L.A TK - Latin America Transaction Kernel: PWA mobile-first",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local": "vite --mode capturas",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:capturas": "playwright test --project=celular",
    "e2e:report": "playwright show-report e2e/.report",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/privacy-screen": "8.0.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/status-bar": "8.0.4",
    "@mantine/charts": "9.7.0",
    "@mantine/colors-generator": "9.7.0",
    "@mantine/core": "9.7.0",
    "@mantine/dates": "9.7.0",
    "@mantine/form": "9.7.0",
    "@mantine/hooks": "9.7.0",
    "@mantine/modals": "9.7.0",
    "@mantine/notifications": "9.7.0",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.104.1",
    "chroma-js": "3.2.0",
    "dayjs": "1.11.23",
    "motion": "^14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/chroma-js": "3.1.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
