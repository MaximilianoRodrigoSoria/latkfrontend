# URL base de la API. En desarrollo se deja vacio: Vite hace proxy de /latk-api a localhost:8080.
# En la app Android (Capacitor) va el origen del backend, sin path: https://api.latk.com.ar
VITE_API_URL=

# Opcionales: sitios Docusaurus publicados y protegidos por rol.
# Las guias dentro de la app funcionan sin configurar estas URLs.
VITE_DOCS_SELLER_URL=
VITE_DOCS_ADMIN_URL=
VITE_DOCS_OPERATOR_URL=
VITE_DOCS_AUDITOR_URL=
